{
  "cli": {
    "version": ">= 7.5.0",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {},
    "fiu": {
      "distribution": "internal",
      "channel": "trunk",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "FIU_VARIANT": "fiu",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
